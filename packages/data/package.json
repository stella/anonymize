{
  "name": "@stll/anonymize-data",
  "version": "0.0.10",
  "description": "Deny list dictionaries and config data for @stll/anonymize",
  "keywords": [
    "anonymization",
    "pii",
    "redaction",
    "ner",
    "pseudonymization",
    "gdpr",
    "privacy",
    "dictionaries"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@stll/anonymize-source": "./dictionaries/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./dictionaries": {
      "@stll/anonymize-source": "./dictionaries/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./cities": {
      "@stll/anonymize-source": "./dictionaries/cities.ts",
      "types": "./dist/cities.d.mts",
      "import": "./dist/cities.mjs",
      "default": "./dist/cities.mjs"
    },
    "./config/*": "./config/*",
    "./dictionaries/*": "./dictionaries/*"
  },
  "types": "dist/index.d.mts",
  "files": [
    "LICENSE",
    "NOTICE",
    "dist",
    "ATTRIBUTION.md",
    "CHANGELOG.md",
    "config",
    "dictionaries/banks",
    "dictionaries/cities",
    "dictionaries/courts",
    "dictionaries/education",
    "dictionaries/government",
    "dictionaries/healthcare",
    "dictionaries/insurance",
    "dictionaries/international",
    "dictionaries/names"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/anonymize.git"
  },
  "homepage": "https://github.com/stella/anonymize",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "generate:city-loaders": "bun run scripts/generate-city-loaders.ts",
    "validate:triggers": "bun run scripts/validate-triggers.ts",
    "check:mirror": "node scripts/check-mirror.mjs",
    "check:city-loaders": "bun run scripts/generate-city-loaders.ts --check",
    "lint": "bun run validate:triggers && bun run check:mirror && bun run check:city-loaders"
  },
  "devDependencies": {
    "stopwords-iso": "1.1.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "@stll/typescript-config": "0.8.0",
    "bun-types": "1.4.4",
    "@types/node": "26.6.4"
  }
}
