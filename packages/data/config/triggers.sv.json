[
  {
    "id": "sv-passport-number",
    "label": "passport number",
    "strategy": {
      "type": "match-pattern",
      "pattern": "^(?:(?=[A-Za-z0-9]{0,8}\\d)[A-Za-z0-9]{9}|[A-Za-z]{1,2}\\d{6,8}|\\d{2}[A-Za-z]{2}\\d{5}|\\d{7,9})\\b(?![\\p{Zs}\\t]{0,8}(?:[-‐‑‒–—―+/:：(\\[{（［｛](?:[\\p{Zs}\\t]{0,8}[-‐‑‒–—―+/.:：(\\[{（［｛])*[\\p{Zs}\\t]{0,8}[\\p{L}\\p{N}]|\\.[\\p{L}\\p{N}]|\\.(?:[\\p{Zs}\\t]{0,8}[-‐‑‒–—―+/.:：(\\[{（［｛])+[\\p{Zs}\\t]{0,8}[\\p{L}\\p{N}]))"
    },
    "triggers": ["passnummer", "pass nr", "pass nr."]
  },
  {
    "id": "sv-national-id",
    "label": "national identification number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["personnummer", "personnr"]
  },
  {
    "id": "sv-company-id",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["organisationsnummer", "org.nr"]
  },
  {
    "id": "sv-address",
    "label": "address",
    "strategy": { "type": "to-next-comma" },
    "triggers": ["folkbokförd i", "folkbokförd på", "bosatt i", "bosatt på"]
  },
  {
    "id": "sv-date-of-birth",
    "label": "date of birth",
    "strategy": {
      "type": "n-words",
      "count": 4
    },
    "triggers": ["född den"]
  },
  {
    "id": "sv-person",
    "label": "person",
    "strategy": { "type": "to-next-comma" },
    "triggers": ["kontaktperson"],
    "validations": [{ "type": "starts-uppercase" }]
  },
  {
    "id": "sv-bank-account",
    "label": "bank account number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["bankgiro", "plusgiro"]
  },
  {
    "id": "sv-tax-id",
    "label": "tax identification number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["momsregistreringsnummer"]
  },
  {
    "id": "sv-clinical-medical-record-number",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["journalnummer", "medicinskt journalnummer"],
    "extensions": ["add-colon", "add-colon-space"],
    "validations": [{ "type": "has-digits" }]
  },
  {
    "id": "sv-clinical-patient-number",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["patientnummer", "patient-ID", "patientidentifikator"],
    "extensions": ["add-colon", "add-colon-space"],
    "validations": [{ "type": "has-digits" }]
  },
  {
    "id": "sv-clinical-health-card-number",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": [
      "sjukförsäkringskortets nummer",
      "försäkringskortsnummer",
      "EU-kortets nummer"
    ],
    "extensions": ["add-colon", "add-colon-space"],
    "validations": [{ "type": "has-digits" }]
  }
]
