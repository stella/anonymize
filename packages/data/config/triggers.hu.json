[
  {
    "id": "hu-passport-number",
    "label": "passport number",
    "strategy": {
      "type": "match-pattern",
      "pattern": "^(?:(?=[A-Za-z0-9]{0,8}\\d)[A-Za-z0-9]{9}|[A-Za-z]{1,2}\\d{6,8}|\\d{2}[A-Za-z]{2}\\d{5}|\\d{7,9})\\b(?![\\p{Zs}\\t]{0,8}(?:[-‐‑‒–—―+/](?:[\\p{Zs}\\t]{0,8}[-‐‑‒–—―+/.])*[\\p{Zs}\\t]{0,8}[\\p{L}\\p{N}]|\\.[\\p{L}\\p{N}]|\\.(?:[\\p{Zs}\\t]{0,8}[-‐‑‒–—―+/.])+[\\p{Zs}\\t]{0,8}[\\p{L}\\p{N}]))"
    },
    "triggers": [
      "útlevélszám",
      "útlevél száma",
      "u\u0301tleve\u0301lsza\u0301m",
      "u\u0301tleve\u0301l sza\u0301ma"
    ]
  },
  {
    "id": "hu-tax-id",
    "label": "tax identification number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["adószám", "adószáma"]
  },
  {
    "id": "hu-company-id",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["cégjegyzékszám"]
  },
  {
    "id": "hu-personal-number",
    "label": "national identification number",
    "strategy": {
      "type": "match-pattern",
      "pattern": "^(?:\\d{11}|\\d-\\d{6}-\\d{4})\\b"
    },
    "triggers": ["személyi szám"]
  },
  {
    "id": "hu-person",
    "label": "person",
    "strategy": { "type": "to-next-comma" },
    "triggers": ["CONTACT_POINT"],
    "extensions": ["add-colon"],
    "validations": [{ "type": "starts-uppercase" }]
  },
  {
    "id": "hu-organization",
    "label": "organization",
    "strategy": { "type": "to-end-of-line" },
    "triggers": ["OFFICIALNAME"],
    "extensions": ["add-colon"]
  },
  {
    "id": "hu-phone",
    "label": "phone number",
    "strategy": { "type": "to-end-of-line" },
    "triggers": ["PHONE"],
    "extensions": ["add-colon"]
  },
  {
    "id": "hu-clinical-medical-record-number",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["kórlapszám", "egészségügyi nyilvántartási szám"],
    "extensions": ["add-colon", "add-colon-space"],
    "validations": [{ "type": "has-digits" }]
  },
  {
    "id": "hu-clinical-patient-number",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["betegazonosító", "betegazonosító szám", "betegszám"],
    "extensions": ["add-colon", "add-colon-space"],
    "validations": [{ "type": "has-digits" }]
  },
  {
    "id": "hu-clinical-health-card-number",
    "label": "registration number",
    "strategy": { "type": "company-id-value" },
    "triggers": ["TAJ-szám", "TAJ szám", "társadalombiztosítási azonosító jel"],
    "extensions": ["add-colon", "add-colon-space"],
    "validations": [{ "type": "has-digits" }]
  }
