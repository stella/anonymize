{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@stll/typescript-config/node.json",
  "compilerOptions": {
    "customConditions": ["@stll/anonymize-source"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src/**/*.ts", "tsdown.config.ts", "native-libc.mjs"],
  "exclude": [
    "node_modules",
    "src/**/__test__/**",
    "src/**/*.test.ts",
    "src/wasm.ts"
  ],
  "files": ["index.cjs", "index.d.cts", "src/native-addon.d.ts"]
}
